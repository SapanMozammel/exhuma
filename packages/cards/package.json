{
	"name": "@exhuma/cards",
	"version": "0.1.0",
	"description": "Tactile, physics-driven interactive cards and horizontal rail scrollers for React",
	"license": "MIT",
	"keywords": [
		"react",
		"cards",
		"stacking-cards",
		"horizontal-scroll",
		"micro-interactions",
		"scroll-animation"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type:check": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.0"
	}
}
